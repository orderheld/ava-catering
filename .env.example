# Öffentliche URL der Website (ohne Slash am Ende)
NEXT_PUBLIC_SITE_URL=https://avacatering.ch

# Neon Postgres (Vercel > Storage > Neon verbindet das automatisch)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Resend (Domain avacatering.ch in Resend verifizieren)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM="AVA Catering <kontakt@avacatering.ch>"
# Wohin neue Anfragen gemeldet werden
MAIL_NOTIFY_TO=kontakt@avacatering.ch

# Admin-Zugang (/admin)
ADMIN_PASSWORD=bitte-ein-langes-passwort-waehlen
# Zufälliger Schlüssel, mind. 32 Zeichen (z.B. PowerShell: [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString())
AUTH_SECRET=

# Vercel Blob für Bild-Uploads im Admin (Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN=
